# --- admin ----------------------------------------------------------------------
def _ask_password(prompt: str) -> str:
    import getpass
    first = getpass.getpass(prompt)
    if first != getpass.getpass("repeat: "):
        die("the two passwords do not match")
    return first


def cmd_admin_passwd(args) -> None:
    password = args.password or os.environ.get("OSM_ADMIN_PASSWORD") or _ask_password(
        "new console password: ")
    try:
        maintenance.set_password(password)
    except ValueError as exc:
        die(str(exc))
    revoked = maintenance.revoke_sessions() if args.revoke_sessions else ""
    print("console password set")
    if revoked:
        print("all sessions signed out; restart the service for it to take effect")


def cmd_admin_forget_password(args) -> None:
