def cmd_admin_reset(args) -> None:
    if not args.yes:
        answer = input(f"clear {args.scope}? type reset: ").strip().lower()
        if answer != "reset":
            raise SystemExit("cancelled")
    from app.config import KUBECONFIG_DIR
    import shutil as _shutil
    if args.scope == "everything":
        maintenance.clear_password()
        maintenance.revoke_sessions()
    store.update(lambda s: s.update({"clusters": {}, "arrays": {}, "installs": {}, "jobs": []}))
    for path in (KUBECONFIG_DIR, replication.REPCTL_HOME):
        if path.exists():
            _shutil.rmtree(path, ignore_errors=True)
    inventory.invalidate()
    print("cleared; nothing was uninstalled from any cluster or array")


def cmd_admin_backup(args) -> None:
    path = maintenance.backup(Path(args.out) if args.out else None)
    print(f"written {path}")
    for name in maintenance.backup_contents(path):
        print("  " + name)


def cmd_admin_restore(args) -> None:
    try:
        restored = maintenance.restore(Path(args.file), force=args.force)
    except (FileNotFoundError, RuntimeError) as exc:
        die(str(exc))
    print(f"restored {len(restored)} entries from {args.file}")
    print("restart the service: osmctl service restart")


def cmd_doctor(args) -> None:
    checks = maintenance.doctor()
    area = None
    bad = 0
    for c in checks:
        if c["area"] != area:
            area = c["area"]
            print(f"\n{area}")
        mark = "ok  " if c["ok"] else "FAIL"
        if not c["ok"]:
            bad += 1
        print(f"  {mark} {c['what']:<38} {c['detail'][:70]}")
        if not c["ok"] and c["fix"]:
            print(f"       fix: {c['fix']}")
    print(f"\n{len(checks) - bad} passed, {bad} failed")
    raise SystemExit(1 if bad else 0)


def cmd_service(args) -> None:
    if args.action == "logs":
        raise SystemExit(maintenance.service_logs(args.lines, args.follow))
    code, out = maintenance.service(args.action)
    if out:
        print(out)
    raise SystemExit(code)


def cmd_jobs(args) -> None:
    rows = maintenance.job_logs(args.limit)
    if args.show:
        match = [r for r in rows if args.show in r["file"]]
        if not match:
            die(f"no job log matching {args.show}")
        print(Path(match[0]["path"]).read_text())
        return
    table(rows, ["when", "kind", "size", "file"])


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="osmctl", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="tools, clusters, arrays and the repctl store").set_defaults(
        func=cmd_status)

    c = sub.add_parser("cluster", help="Kubernetes clusters").add_subparsers(
        dest="sub", required=True)
    a = c.add_parser("add", help="add a cluster by kubeconfig or login")
    a.add_argument("--id", required=True)
    a.add_argument("--kubeconfig")
    a.add_argument("--server")
    a.add_argument("--user", default="kubeadmin")
    a.add_argument("--password")
    a.add_argument("--role", default="source", choices=["source", "target"])
    a.add_argument("--namespace", default=DRIVER_NAMESPACE_DEFAULT)
    a.add_argument("--verify-tls", action="store_true")
    a.set_defaults(func=cmd_cluster_add)
    c.add_parser("list", help="clusters this console knows").set_defaults(func=cmd_cluster_list)
    r = c.add_parser("rbac", help="what the stored identity may do")
    r.add_argument("--id", required=True)
    r.set_defaults(func=cmd_cluster_rbac)
    sa = c.add_parser("serviceaccount", help="create a service account kubeconfig")
    sa.add_argument("--id", required=True)
    sa.add_argument("--name", default=k8s.SA_NAME)
    sa.add_argument("--namespace", default=k8s.SA_NAMESPACE)
    sa.add_argument("--role", default=k8s.SA_CLUSTER_ROLE)
    sa.set_defaults(func=cmd_cluster_sa)
    rm = c.add_parser("remove", help="forget a cluster")
    rm.add_argument("--id", required=True)
    rm.set_defaults(func=cmd_cluster_remove)

    ar = sub.add_parser("array", help="PowerScale arrays").add_subparsers(dest="sub", required=True)
    aa = ar.add_parser("add")
    aa.add_argument("--endpoint", required=True)
    aa.add_argument("--user", required=True)
    aa.add_argument("--password")
