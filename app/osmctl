def cmd_admin_link_repctl(args) -> None:
    """Point /usr/local/bin/repctl at the console's cluster store."""
    binary = Path(tools.which("repctl") or "")
    real = Path("/opt/ocpstorage/bin/repctl")
    from app.config import BIN_DIR
    target = BIN_DIR / "repctl"
    if not target.exists():
        target = real if real.exists() else binary
    if not target or not Path(target).exists():
        die("repctl is not installed; run osmctl tools install-repctl")
    link = tools._link_into_path(Path(target))
    if not link:
        die(f"could not write {tools.SYSTEM_BIN}/repctl; something else owns that name")
    print(f"{link} now runs {target} against the console's store")
    print("check it with: repctl cluster get")


def cmd_admin_tls(args) -> None:
    """Make a self-signed certificate so the console can serve https."""
    import subprocess as sp
    from app.config import DATA_DIR
    cert_dir = DATA_DIR / "tls"
    cert_dir.mkdir(parents=True, exist_ok=True)
    cert, key = cert_dir / "console.crt", cert_dir / "console.key"
    hosts = [h for h in [args.host] if h]
    alt = ",".join(["DNS:" + h if not h.replace(".", "").isdigit() else "IP:" + h
                    for h in hosts] + ["DNS:localhost", "IP:127.0.0.1"])
    rc = sp.run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
                 "-keyout", str(key), "-out", str(cert), "-days", str(args.days),
                 "-subj", f"/CN={hosts[0] if hosts else 'osm-console'}",
                 "-addext", f"subjectAltName={alt}"], capture_output=True)
    if rc.returncode != 0:
        die(rc.stderr.decode()[:200])
    for path in (cert, key):
        path.chmod(0o600)
    print(f"certificate: {cert}\nkey        : {key}")
    print("\nServe https by adding these to the service, then restarting it:")
    print(f"  systemctl set-environment  # or edit /etc/systemd/system/ocpstorage-console.service")
    print(f"  Environment=OSM_TLS_CERT={cert}")
    print(f"  Environment=OSM_TLS_KEY={key}")
    print(f"  Environment=OSM_PORT=8443")
    print("\nThe redirect address to register with the provider is then:")
    print(f"  https://{hosts[0] if hosts else '<host>'}:8443/auth/oidc/callback")


