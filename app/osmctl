#!/opt/ocpstorage/app/.venv/bin/python
"""osmctl - the OSM console's operations from a shell.

Everything the web pages do is available here, against the same state, so the console
being down never blocks an installation or a failover.

  osmctl status
  osmctl cluster add --id cluster-1 --server https://api.x:6443 --user kubeadmin --password ...
  osmctl cluster add --id cluster-2 --kubeconfig /root/.kube/config
  osmctl cluster list | rbac --id | serviceaccount --id
  osmctl array add --endpoint 192.168.68.140 --user csiuser --password ...
  osmctl driver install --cluster cluster-1 --mode replication [--method helm|operator]
  osmctl sc create --name isilon --cluster cluster-1 --array isin-main [--replicated ...]
  osmctl repctl register        # repctl cluster add for every known cluster
  osmctl repctl -- cluster get  # anything else, with the right environment
  osmctl rg list
  osmctl rg failover --rg <name> --target cluster-2 [--unplanned]
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from app import store                                            # noqa: E402
from app.config import DRIVER_NAMESPACE_DEFAULT, match_owner                  # noqa: E402
from app.services import (installer, inventory, k8s, maintenance, replication,  # noqa: E402
                          tools)
from app.services.arrays import ArrayError, OneFS                # noqa: E402
from app.services.jobs import run_sync                           # noqa: E402


def die(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def table(rows: list[dict], columns: list[str]) -> None:
    if not rows:
        print("(nothing)")
        return
    widths = {c: max(len(c), *(len(str(r.get(c, ""))) for r in rows)) for c in columns}
    print("  ".join(c.upper().ljust(widths[c]) for c in columns))
    for r in rows:
        print("  ".join(str(r.get(c, "")).ljust(widths[c]) for c in columns))


# --- status --------------------------------------------------------------------
def cmd_status(args) -> None:
    data = inventory.snapshot(force=True)
    print("tools")
    table([{"tool": n, "found": "yes" if t["found"] else "no", "version": t["version"],
            "path": t["path"]} for n, t in data["tools"].items()],
          ["tool", "found", "version", "path"])
    print("\nclusters")
    table([{"id": c["id"], "role": c.get("role", ""), "server": c.get("server", ""),
            "reachable": "yes" if c.get("reachable") else "no",
            "driver": "ready" if c.get("driver", {}).get("controller_ready") else "-"}
           for c in data["clusters"]], ["id", "role", "server", "reachable", "driver"])
    print("\narrays")
    table([{"name": a.get("name", a.get("id")), "endpoint": a.get("endpoint", ""),
            "onefs": a.get("onefs_version", ""),
            "reachable": "yes" if a.get("reachable") else "no",
            "synciq": a.get("synciq_service", "")} for a in data["arrays"]],
          ["name", "endpoint", "onefs", "reachable", "synciq"])
    listing = replication.list_clusters()
    print(f"\nrepctl store: {listing['path']}")
    if listing["rows"]:
        table(listing["rows"], ["id", "version", "url"])
    else:
        print(listing.get("error", "empty"))


# --- clusters ------------------------------------------------------------------
def cmd_cluster_add(args) -> None:
    cid = args.id.strip().lower()
    if args.kubeconfig:
        try:
            content = Path(args.kubeconfig).read_text()
        except OSError as exc:
            die(str(exc))
        path = k8s.save_kubeconfig(cid, content)
    elif args.server:
        password = args.password or os.environ.get("OSM_PASSWORD") or ""
        if not password:
            import getpass
            password = getpass.getpass(f"password for {args.user}: ")
        path = k8s.login_kubeconfig(args.server, args.user, password, cid,
                                    insecure=not args.verify_tls)
    else:
        die("give --kubeconfig or --server with --user")
    info = k8s.probe(path)
    record = {
        "id": cid, "role": args.role, "namespace": args.namespace,
        "kubeconfig": str(path), "server": info.get("server", ""), "added": store.now(),
        "admin_kubeconfig": str(path), "service_account_kubeconfig": "",
        "openshift": info.get("is_openshift", False),
        "openshift_version": info.get("openshift_version", ""),
        "kubernetes_version": info.get("kubernetes_version", ""),
        "connected_via": "kubeconfig" if args.kubeconfig else "login",
        "connected_as": info.get("user", ""),
    }
    store.update(lambda s: s["clusters"].update({cid: record}))
    inventory.invalidate()
    print(f"added {cid}: {info.get('server')} as {info.get('user')}, "
          f"cluster-admin={info.get('cluster_admin')}")


def cmd_cluster_list(args) -> None:
    rows = [{"id": c["id"], "role": c.get("role", ""), "server": c.get("server", ""),
             "identity": c.get("connected_as", ""),
             "kubeconfig": c.get("kubeconfig", "")}
            for c in store.load()["clusters"].values()]
    table(rows, ["id", "role", "server", "identity", "kubeconfig"])


def cmd_cluster_rbac(args) -> None:
    cluster = store.load()["clusters"].get(args.id) or die(f"unknown cluster {args.id}")
    report = k8s.rbac_report(cluster["kubeconfig"])
    table([{"permission": f"{r['verb']} {r['resource']}",
            "allowed": "yes" if r["ok"] else "NO", "needed for": r["why"]} for r in report],
          ["permission", "allowed", "needed for"])


def cmd_cluster_sa(args) -> None:
    state = store.load()
    cluster = state["clusters"].get(args.id) or die(f"unknown cluster {args.id}")

    def work(job):
        content = k8s.create_sa_kubeconfig(job, cluster["admin_kubeconfig"], args.id,
                                           ns=args.namespace, sa=args.name, role=args.role)
        path = k8s.kubeconfig_path(f"{args.id}-sa")
        path.write_text(content)
        path.chmod(0o600)
        match_owner(path)
        job.log(f"saved {path}")
        store.update(lambda s: s["clusters"][args.id].update({
            "service_account_kubeconfig": str(path), "kubeconfig": str(path),
            "sa_name": args.name, "sa_namespace": args.namespace, "sa_role": args.role}))
        inventory.invalidate()

    job = run_sync(f"service account on {args.id}", "kubeconfig", work, cluster=args.id)
    raise SystemExit(0 if job.status == "ok" else 1)


def cmd_cluster_remove(args) -> None:
    store.update(lambda s: s["clusters"].pop(args.id, None))
    inventory.invalidate()
    print(f"removed {args.id} from the console; nothing was uninstalled")


# --- arrays --------------------------------------------------------------------
def cmd_array_add(args) -> None:
    password = args.password or os.environ.get("OSM_ARRAY_PASSWORD") or ""
    if not password:
        import getpass
        password = getpass.getpass(f"password for {args.user}@{args.endpoint}: ")
    client = OneFS(args.endpoint, args.port, args.user, password, verify=args.verify_tls,
                   auth_type=args.auth_type)
    try:
        info = client.inspect()
    except ArrayError as exc:
        die(str(exc))
    if args.create_path and not client.check_path(args.path)["exists"]:
        client.create_path(args.path)
    aid = (info.get("name") or args.endpoint).lower()
    record = {
        "id": aid, "name": info.get("name") or aid, "endpoint": args.endpoint,
        "port": args.port, "username": args.user, "password": password,
        "isi_path": args.path, "access_zone": args.zone,
        "skip_cert_validation": not args.verify_tls, "is_default": args.default,
        "auth_type": args.auth_type, "auth_mode": info.get("auth_mode", "session"),
        "added": store.now(),
        "replication_certificate_id": info.get("synciq_cluster_certificate_id", ""),
        "onefs_version": info.get("onefs_version", ""),
        "path_ok": client.check_path(args.path)["exists"],
    }
    store.update(lambda s: s["arrays"].update({aid: record}))
    inventory.invalidate()
    print(f"added {record['name']} ({args.endpoint}), OneFS {record['onefs_version']}, "
          f"{record['auth_mode']} auth (isiAuthType {record['auth_type']})")
    if info.get("missing_privileges"):
        print("missing privileges: " + ", ".join(info["missing_privileges"]))


def cmd_array_list(args) -> None:
    rows = [{"id": a["id"], "name": a["name"], "endpoint": a["endpoint"],
             "auth": a.get("auth_mode", "session"),
             "path": a["isi_path"], "default": "yes" if a.get("is_default") else ""}
            for a in store.load()["arrays"].values()]
    table(rows, ["id", "name", "endpoint", "auth", "path", "default"])


# --- driver --------------------------------------------------------------------
def cmd_driver_install(args) -> None:
    state = store.load()
    cluster = state["clusters"].get(args.cluster) or die(f"unknown cluster {args.cluster}")
    arrays = list(state["arrays"].values())
    if not arrays:
        die("register an array first")
    opts = {
        "endpoint_port": args.port, "skip_cert_validation": not args.verify_tls,
        "auth_type": args.auth_type, "access_zone": args.zone, "isi_path": args.path,
        "enable_quota": not args.no_quota, "replication": args.mode == "replication",
        "snapshots": not args.no_snapshots, "controller_count": args.replicas,
        "openshift": cluster.get("openshift", True),
        "target_cluster_ids": [c["id"] for c in state["clusters"].values()
                               if c["id"] != args.cluster],
    }
    ns = args.namespace or cluster.get("namespace", DRIVER_NAMESPACE_DEFAULT)
    default_array = args.default_array or arrays[0]["id"]

    def work(job):
        for w in dict.fromkeys(installer.support_warnings(
                cluster.get("openshift_version", ""),
                [a.get("onefs_version", "") for a in arrays])):
            job.log("note: " + w)
        if args.method == "operator":
            pkgs = installer.operator_catalog_options(cluster["kubeconfig"])
            pkg = args.package or (pkgs[0]["package"] if pkgs else "")
            if not pkg:
                raise RuntimeError("no Dell operator package in this cluster's catalogs")
            channel = args.channel or next(
                (p["default_channel"] for p in pkgs if p["package"] == pkg), "stable")
            source = next((p["catalog"] for p in pkgs if p["package"] == pkg),
                          "certified-operators")
            installer.operator_install(job, cluster["kubeconfig"], pkg, channel, source)
            installer.operator_apply_cr(job, cluster["kubeconfig"], ns, opts, arrays, default_array)
        else:
            installer.helm_install_driver(job, cluster["kubeconfig"], ns, opts, arrays,
                                          upgrade=args.upgrade, default_array_id=default_array)
        store.update(lambda s: s["installs"].update({args.cluster: {
            "method": args.method, "namespace": ns, "mode": args.mode,
            "when": store.now(), "arrays": [a["id"] for a in arrays],
            "default_array": default_array}}))
        inventory.invalidate()

    job = run_sync(f"install driver on {args.cluster}", "driver", work, cluster=args.cluster)
    raise SystemExit(0 if job.status == "ok" else 1)


def cmd_driver_uninstall(args) -> None:
    cluster = store.load()["clusters"].get(args.cluster) or die(f"unknown cluster {args.cluster}")
    ns = args.namespace or cluster.get("namespace", DRIVER_NAMESPACE_DEFAULT)
    job = run_sync(f"uninstall driver on {args.cluster}", "driver",
                   lambda j: installer.helm_uninstall_driver(j, cluster["kubeconfig"], ns),
                   cluster=args.cluster)
    raise SystemExit(0 if job.status == "ok" else 1)


# --- storage classes ------------------------------------------------------------
def cmd_sc_create(args) -> None:
    state = store.load()
    src = state["clusters"].get(args.cluster) or die(f"unknown cluster {args.cluster}")
    array = state["arrays"].get(args.array) or die(f"unknown array {args.array}")
    opts = {"access_zone": args.zone, "isi_path": args.path,
            "az_service_ip": args.nfs_address or array["endpoint"],
            "root_client_enabled": args.root_client,
            "reclaim_policy": args.reclaim, "binding_mode": args.binding}
    rep = None
    if args.replicated:
        tgt = state["clusters"].get(args.target_cluster) or die("give --target-cluster")
        tgt_array = state["arrays"].get(args.target_array) or die("give --target-array")
        rep = {"remote_storage_class": args.name, "remote_cluster_id": tgt["id"],
               "remote_system": tgt_array["name"],
               "remote_az_service_ip": args.target_nfs_address or tgt_array["endpoint"],
               "rpo": args.rpo, "ignore_namespaces": args.ignore_namespaces,
               "volume_group_prefix": args.volume_group_prefix,
               "remote_access_zone": tgt_array.get("access_zone", "System")}

    def work(job):
        installer.apply_storage_class(job, src["kubeconfig"],
                                      installer.storage_class_manifest(args.name, array, opts, rep))
        if rep:
            back = dict(rep)
            back.update({"remote_cluster_id": src["id"], "remote_system": array["name"],
                         "remote_az_service_ip": opts["az_service_ip"],
                         "remote_access_zone": array.get("access_zone", "System")})
            tgt = state["clusters"][args.target_cluster]
            tgt_array = state["arrays"][args.target_array]
            tgt_opts = dict(opts)
            tgt_opts["az_service_ip"] = args.target_nfs_address or tgt_array["endpoint"]
            installer.apply_storage_class(
                job, tgt["kubeconfig"],
                installer.storage_class_manifest(args.name, tgt_array, tgt_opts, back))
        inventory.invalidate()

    job = run_sync(f"storage class {args.name}", "storageclass", work, cluster=args.cluster)
    raise SystemExit(0 if job.status == "ok" else 1)


# --- repctl ---------------------------------------------------------------------
def cmd_repctl_register(args) -> None:
    clusters = list(store.load()["clusters"].values())
    if not clusters:
        die("no clusters registered in the console")
    job = run_sync("register clusters with repctl", "repctl",
                   lambda j: replication.add_clusters(j, clusters))
    listing = replication.list_clusters()
    print(f"\nrepctl store: {listing['path']}")
    table(listing["rows"], ["id", "version", "url"]) if listing["rows"] else print(listing["error"])
    raise SystemExit(0 if job.status == "ok" else 1)


def cmd_repctl_passthrough(args) -> None:
    binary = tools.which("repctl") or die("repctl is not installed; run osmctl tools install-repctl")
    proc = subprocess.run([binary] + args.args, env=replication.repctl_env())
    raise SystemExit(proc.returncode)


def cmd_repctl_setup(args) -> None:
    state = store.load()
    src = state["clusters"].get(args.source) or die(f"unknown cluster {args.source}")
    tgt = state["clusters"].get(args.target) or die(f"unknown cluster {args.target}")

    def work(job):
        installer.helm_install_replication_controller(job, src["kubeconfig"], src["id"], [tgt["id"]])
        installer.helm_install_replication_controller(job, tgt["kubeconfig"], tgt["id"], [src["id"]])
        replication.add_clusters(job, [src, tgt])
        replication.inject(job, [src["id"], tgt["id"]], use_sa=not args.admin_configs,
                           kubeconfigs={src["id"]: src["kubeconfig"],
                                        tgt["id"]: tgt["kubeconfig"]})
        for site, peer in ((src, tgt), (tgt, src)):
            replication.configure_controller(
                job, site["kubeconfig"], site["id"],
                [{"clusterId": peer["id"], "address": peer.get("server", ""),
                  "secretRef": peer["id"]}])
        for site, peer in ((src, tgt), (tgt, src)):
            settled = replication.controller_config(site["kubeconfig"])
            print(f"  {site['id']}: clusterId={settled.get('clusterId') or 'empty'} "
                  f"targets={[t.get('clusterId') for t in settled.get('targets') or []]}")
        inventory.invalidate()

    job = run_sync(f"wire replication {args.source} to {args.target}", "replication", work)
    raise SystemExit(0 if job.status == "ok" else 1)


def cmd_tools_install_repctl(args) -> None:
    def work(job):
        if args.file:
            tools.install_repctl_from_upload(job, Path(args.file).read_bytes(), args.file)
        elif args.build:
            tools.build_repctl_from_source(job, args.version)
        else:
            url = args.url or tools.default_repctl_choice()["url"]
            tools.install_repctl_from_url(job, url)

    job = run_sync("install repctl", "repctl", work)
    raise SystemExit(0 if job.status == "ok" else 1)


