def cmd_rg_action(args) -> None:
    preview = replication.action_preview(args.rg, args.action, args.target,
                                         args.unplanned, args.discard)
    print(preview)
    if not args.yes:
        answer = input("run this? type yes: ").strip().lower()
        if answer != "yes":
            raise SystemExit("cancelled")
    kubeconfig = None
    for cluster in store.load()["clusters"].values():
        if replication.rg_state(cluster["kubeconfig"], args.rg).get("state"):
            kubeconfig = cluster["kubeconfig"]
            break
    job = run_sync(f"{args.action} {args.rg}", "replication-action",
                   lambda j: replication.act(j, args.rg, args.action, args.target,
                                             args.unplanned, args.discard, kubeconfig=kubeconfig))
    raise SystemExit(0 if job.status == "ok" else 1)


# --- admin ----------------------------------------------------------------------
def _ask_password(prompt: str) -> str:
    import getpass
    first = getpass.getpass(prompt)
    if first != getpass.getpass("repeat: "):
        die("the two passwords do not match")
    return first


def cmd_admin_passwd(args) -> None:
    password = args.password or os.environ.get("OSM_ADMIN_PASSWORD") or _ask_password(
        "new console password: ")
    try:
        maintenance.set_password(password)
    except ValueError as exc:
        die(str(exc))
    revoked = maintenance.revoke_sessions() if args.revoke_sessions else ""
    print("console password set")
    if revoked:
        print("all sessions signed out; restart the service for it to take effect")


def cmd_admin_forget_password(args) -> None:
