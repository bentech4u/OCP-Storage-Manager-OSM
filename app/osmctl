def cmd_audit(args) -> None:
    if args.sub == "verify":
        result = audit.verify()
        if result["ok"]:
            print(f"the record is intact: {result['checked']} entries, "
                  f"files {', '.join(result.get('files', [])) or 'none'}")
            return
        die(result["problem"])
    rows = audit.entries(limit=args.limit, actor=args.actor, action=args.action,
                         target=args.target, since=args.since, until=args.until, text=args.text)
    if args.sub == "export":
        body = audit.to_csv(rows)
        if args.out:
            Path(args.out).write_text(body)
            print(f"written {args.out} ({len(rows)} entries)")
        else:
            print(body, end="")
        return
    table([{"when": r["at"][:19].replace("T", " "), "who": r["actor"][:28],
            "what": r["action"], "where": (r.get("target") or "")[:28],
            "outcome": r.get("outcome", ""), "detail": (r.get("detail") or "")[:46]}
           for r in rows], ["when", "who", "what", "where", "outcome", "detail"])


def cmd_alerts(args) -> None:
    if args.sub == "list":
        rows = [{"severity": a["severity"], "title": a["title"][:58],
                 "where": a.get("where", ""), "since": a.get("first_seen", "")[:19]}
                for a in monitor.open_alerts()]
        table(rows, ["severity", "title", "where", "since"])
        return
    if args.sub == "check":
        result = monitor.run_once(send=args.send)
        rows = [{"severity": f["severity"], "title": f["title"][:58], "where": f.get("where", "")}
                for f in result["findings"]]
        table(rows, ["severity", "title", "where"])
        print(f"\n{len(result['findings'])} finding(s), "
              f"{len(result['notified'])} new or repeated, {result['sent']} delivery attempt(s) "
              f"{'sent' if args.send else 'suppressed, pass --send to deliver'}")
        raise SystemExit(1 if result["findings"] else 0)
    if args.sub == "test":
        from app.services import notify
        cfg = store.load()["setup"]["alerts"]
        alert = {"key": "test", "severity": "warning", "title": "Test alert from OSM",
                 "detail": "Sent by hand to check delivery.", "where": "osmctl",
                 "first_seen": store.now(), "advice": ""}
        for line in notify.deliver(cfg, alert):
            print("  " + line)


# --- moving a version to a site with no internet --------------------------------
def cmd_update(args) -> None:
    if args.sub == "pack":
        try:
            path = release.pack(Path(args.out) if args.out else None, args.ref)
        except release.ReleaseError as exc:
            die(str(exc))
        info = release.inspect(path)
        size = path.stat().st_size
        print(f"{path}  ({size // 1024} KB)")
        print(f"  version {info['version']}  commit {info['commit']}  {info['count']} files")
        print("\nCopy that one file to the installer and run:")
        print(f"  osmctl update apply {path.name}")
        return

    if args.sub == "show":
        if args.file:
            info = release.inspect(Path(args.file))
            plan = release.differences(Path(args.file))
            print(f"bundle {Path(args.file).name}")
            print(f"  version {info['version']}  commit {info['commit']}  built {info['created']}")
            print(f"  {len(plan['added'])} new, {len(plan['changed'])} changed, "
                  f"{len(plan['same'])} already identical, {len(plan['kept'])} site-owned")
            for name in plan["added"]:
                print(f"    new      {name}")
            for name in plan["changed"]:
                print(f"    changed  {name}")
            return
        here = release.installed()
        if here:
            print(f"installed version {here.get('version', '?')}  commit "
                  f"{here.get('commit', '?')}  applied from a bundle built {here.get('created', '?')}")
        else:
            print("no bundle has been applied here; this tree came from git or a copy")
        kept = release.backups()
        if kept:
            print("\nbackups kept by earlier updates, newest first:")
            for b in kept:
                print(f"  {b}")
        return

    if args.sub == "apply":
        path = Path(args.file)
        try:
            plan = release.differences(path)
        except (release.ReleaseError, OSError, Exception) as exc:   # noqa: BLE001
            die(f"cannot read {path}: {exc}")
        info = plan["manifest"]
        print(f"bundle {path.name}: version {info['version']}, commit {info['commit']}, "
              f"built {info['created']}")
        print(f"{len(plan['added'])} new file(s), {len(plan['changed'])} changed, "
              f"{len(plan['same'])} already identical, {len(plan['kept'])} kept as this site "
              "has its own")
        for name in plan["changed"][:20]:
            print(f"  changed  {name}")
        for name in plan["kept"]:
            print(f"  kept     {name}  (yours differs from the bundle's; not touched)")
        print("nothing under data, secrets, bin or .repctl is in a bundle, so clusters, "
              "arrays, kubeconfigs and repctl's store are untouched")
        if not plan["added"] and not plan["changed"]:
            print("nothing to do: this installation already matches the bundle")
            return
        if not args.yes:
            answer = input("apply this? type yes: ").strip().lower()
            if answer != "yes":
                print("nothing applied")
                return
        try:
            result = release.apply(path, restart=not args.no_restart)
        except release.ReleaseError as exc:
            die(str(exc))
        try:
            from app.services import audit as audit_now
            audit_now.record("console.update", actor=os.environ.get("SUDO_USER") or "osmctl",
                             via="shell", target=result["version"], job="",
                             outcome="rolled-back" if result["rolled_back"] else "ok",
                             detail=f"{result['written']} files from {path.name}, commit "
                                    f"{result['commit']}", backup=result["backup"])
        except Exception as exc:                            # noqa: BLE001
            print(f"(the update was not written to the audit record: {exc})")
        print(f"\nwrote {result['written']} file(s); previous copies kept in {result['backup']}")
        if result["requirements_changed"]:
            print("NOTE: app/requirements.txt changed in this bundle. The virtual environment "
                  "is not updated by an update, and this host has no internet: carry the new "
                  "wheels across and run .venv/bin/pip install -r app/requirements.txt.")
        if result["rolled_back"]:
            die("the console did not answer after the restart, so the previous version was put "
                "back" + ("" if result.get("healthy_after_rollback") else
                          " - and it is not answering either; check: osmctl service status"))
        if result["restarted"]:
            print("restarted, and the console answered on its health endpoint")
        check = result.get("integration") or {}
        if check:
            print(f"integration after the update: {check['clusters']} cluster(s) "
                  f"({check['reachable_clusters']} reachable), {check['arrays']} array(s) "
                  f"({check['reachable_arrays']} reachable), {check['repctl']} registered with "
                  "repctl")
            for problem in check.get("problems", []):
                print(f"  CHECK: {problem}")
        else:
            print("not restarted; run: osmctl service restart")
        return

    if args.sub == "rollback":
        kept = release.backups()
        if not kept:
            die("no backups from earlier updates")
        path = Path(args.file) if args.file else kept[0]
        if not args.yes:
            answer = input(f"put {path.name} back? type yes: ").strip().lower()
            if answer != "yes":
                print("nothing changed")
                return
        count = release.restore(path)
        print(f"restored {count} file(s) from {path}")
        try:
            from app.services import audit as audit_now, maintenance as maint_now
            audit_now.record("console.rollback", actor=os.environ.get("SUDO_USER") or "osmctl",
                             via="shell", target=path.name, outcome="ok",
                             detail=f"{count} files restored")
            maint_now.service("restart")
            print("restarted")
        except Exception as exc:                            # noqa: BLE001
            print(f"restart it by hand: systemctl restart ocpstorage-console ({exc})")


def cmd_doctor(args) -> None:
    checks = maintenance.doctor()
    area = None
    bad = 0
    for c in checks:
        if c["area"] != area:
            area = c["area"]
            print(f"\n{area}")
        mark = "ok  " if c["ok"] else "FAIL"
        if not c["ok"]:
            bad += 1
        print(f"  {mark} {c['what']:<38} {c['detail'][:70]}")
        if not c["ok"] and c["fix"]:
            print(f"       fix: {c['fix']}")
    print(f"\n{len(checks) - bad} passed, {bad} failed")
    raise SystemExit(1 if bad else 0)


def cmd_service(args) -> None:
    if args.action == "logs":
        raise SystemExit(maintenance.service_logs(args.lines, args.follow))
    code, out = maintenance.service(args.action)
    if out:
        print(out)
    raise SystemExit(code)


def cmd_jobs(args) -> None:
    rows = maintenance.job_logs(args.limit)
    if args.show:
        match = [r for r in rows if args.show in r["file"]]
        if not match:
            die(f"no job log matching {args.show}")
        print(Path(match[0]["path"]).read_text())
        return
    table(rows, ["when", "kind", "size", "file"])


