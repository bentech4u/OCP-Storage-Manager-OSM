        ac.set_defaults(func=cmd_rg_action, action=name)
    return p


if __name__ == "__main__":
    parser = build_parser()
    parsed = parser.parse_args()
    if BROKEN and parsed.func is not cmd_update:
        die(f"this installation cannot be loaded ({BROKEN}).\n"
            "       The update commands still work: 'osmctl update rollback' puts the "
            "previous version back,\n       and 'osmctl update apply <bundle>' installs "
            "a good one.")
    parsed.func(parsed)
